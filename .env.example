# ---- Xperion Airways · MAR reference build v10 ----------------------------
# Copy to .env and edit. Never commit .env (it is gitignored).

# Where this instance listens. Use a port nothing else on the VM is using.
PORT=7810
HOST=0.0.0.0

# Its OWN database file. Must not point at another instance's data folder.
DB_PATH=./data/xperion-v10.db

# Optional: serve under a sub-path, e.g. https://host/xperion-v10/
# BASE_PATH=/xperion-v10

# ---- Optional integrations. Absent = honest degraded mode, never fake success.
# ANTHROPIC_API_KEY=          # absent -> deterministic fallback agent
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Xperion Airways <no-reply@flyxperion.example>"
# DEMO_EMAIL_TO=              # route all demo mail to one inbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# CDP_AGENT_ENABLED=0         # 1 = self-extending segment sync

# ---- Autonomy layer -------------------------------------------------------
# Nothing required. Rollout gate lives in the graph (policy:autonomy_gate).
# Shadow mode = start, then POST /api/autonomy/kill {"global":true}
