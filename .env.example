# ---- Xperion Airways · MAR reference build v10 ----------------------------
# Copy to .env and edit. Never commit .env (it is gitignored).
# Every variable here is one the server actually reads. Absent = that
# integration runs in honest simulated mode, never fake success.
# To carry a live setup over from an earlier deployment, copy the same-named
# keys from that deployment's .env: the names did not change.

# ---- Instance ------------------------------------------------------------------
PORT=7811
HOST=0.0.0.0
DB_PATH=./data/xperion-v10.db
# BASE_PATH=/xperion-v10
# ADMIN_PASSWORD=
# DEFAULT_AIRLINE=xperion

# ---- Live AI assistant (absent = deterministic fallback agent) -----------------
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# AGENT_TIMEOUT_MS=

# ---- Email (absent = emails stored in the DB outbox) ---------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Xperion Airways <no-reply@flyxperion.example>"
# DEMO_EMAIL_TO=

# ---- WhatsApp -------------------------------------------------------------
# WA_MODE=baileys    dials out to WhatsApp over Baileys: no webhook, no Twilio, no public URL.
#                    First run prints a QR in the server log; scan it from the BURNER phone
#                    (Linked Devices). Credentials persist in data/baileys-auth/. Unofficial
#                    client; the number can be banned, so never pair a personal number.
# WA_GUESTS=1        unknown senders become anonymous guests (default on with Baileys)
# WA_ALLOWED_NUMBERS=919871724927,447700900123   extra numbers the bot may message unprompted
# WA_ALLOW_ALL=1     disable the opt-in rule (never do this on a number you care about)
# WA_PAIRING_PHONE=918595960365   pair with an 8-character code instead of scanning a QR
# WA_PHONE_MAP=919871724927:daniel   pin a demo phone to a persona (digits:persona, comma-separated)
# WA_SELF_CHAT=0     off when a separate number is pinned; leave unset for one-number self-chat testing
# WA_QR_LARGE=1      print the QR at full size if the small one won't scan
# Anything other than WA_MODE=baileys keeps the Twilio webhook path below.
# ---- SMS + WhatsApp via Twilio (absent = logged with status 'queued') ----------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_DEFAULT_TO=
# WA_INTERACTIVE=1
# WA_BUTTONS_CONTENT_SID=
# WA_LIST_CONTENT_SID=

# ---- Push (absent = logged) ----------------------------------------------------
# EXPO_PUSH=1
# FCM_SERVER_KEY=

# ---- Adobe Real-Time CDP (absent = PROFILE_SOURCE local, simulated) ------------
# PROFILE_SOURCE=adobe
# ADOBE_CDP_ENABLED=1
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_IMS_ORG=
# ADOBE_IMS_URL=
# ADOBE_SCOPES=
# ADOBE_SANDBOX=
# ADOBE_TENANT_NS=
# ADOBE_IDENTITY_NS=
# ADOBE_LOYALTY_NS=
# ADOBE_LOOKUP_ATTR=
# ADOBE_LOOKUP_VALUE=
# ADOBE_STREAMING_URL=
# ADOBE_INGEST_API=
# ADOBE_PROFILE_API=
# ADOBE_PROFILE_VIEW=
# ADOBE_PROFILE_SCHEMA_ID=
# ADOBE_PROFILE_DATASET_ID=
# ADOBE_EVENT_SCHEMA_ID=
# ADOBE_EVENT_DATASET_ID=
# ADOBE_EVENT_FLOW_ID=
# ADOBE_EVENT_SYNC_VALIDATION=
# ADOBE_SCHEMA_API=
# ADOBE_IDNS_API=
# ADOBE_AUDIENCE_NAMES=
# ADOBE_LOCAL_SEGMENTS_FIELD=
# AEP_AUDIENCE_PREFIX=
# CDP_AGENT_ENABLED=0
# CDP_AGENT_INTERVAL_MS=
# CDP_AGENT_MAX_AUDIENCES=

# ---- AEM content (absent = bundled sample content) -----------------------------
# AEM_ENABLED=1
# AEM_GRAPHQL_URL=
# AEM_AUTH_TOKEN=
# AEM_PROJECT=
# AEM_Q_DESTINATIONS=
# AEM_Q_OFFERS=

# ---- Partner PSS app (Supabase-backed) -----------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# PSS_WEBHOOK_SECRET=
# PSS_FLUSH_MS=

# ---- Retail engine tuning ------------------------------------------------------
# RETAIL_OFFER_TTL_MS=1200000   (4000 only when running the test suite)
# RETAIL_BUNDLE_MIN_P=
# SEARCH_OFFER_MS=
# SEARCH_FOLLOWUP_MS=

# ---- Destination intelligence (weather feeds · research briefs · T-72 briefs) ----------------
# All free sources, no keys: NWS alerts (US), Open-Meteo forecast + geocoding, Nager.Date holidays.
# Research briefs use ANTHROPIC_API_KEY with the web search tool; without it, briefs are facts-only.
# FEEDS_ENABLED=1              live weather → sensing pipeline (0 to disable)
# FEEDS_INTERVAL_MS=1800000    poll cadence (30 min)
# BRIEFS_ENABLED=1             T-72 destination briefs for every booked trip (0 to disable)
# BRIEFS_INTERVAL_MS=1800000   scheduler cadence
# BRIEF_T_MIN_H=60             brief window: 60–84 h before departure
# BRIEF_T_MAX_H=84
# RESEARCH_ENABLED=1           0 = facts-only even with a key
# RESEARCH_MODEL=              defaults to CLAUDE_MODEL
# RESEARCH_MODE=on-demand      on-demand (default): the analyst runs only while the site is in use or when
#                              explicitly asked; scheduled briefs while idle are facts-only (free).
#                              always: the scheduler may research unattended.
# RESEARCH_ACTIVE_MIN=30       minutes since the last request that still count as "in use"
# RESEARCH_DAILY_MAX=15        hard cap on analyst calls per UTC day (all modes)
# RESEARCH_COST_PER_CALL=0.04  for the estimate on the ops page
# RESEARCH_MAX_PER_HOUR=20     burst cap on analyst calls (≈ $0.02–0.05 each)
# FEEDS_IDLE_INTERVAL_MS=10800000  free weather feeds slow to every 3 h after an hour of no use
# RESEARCH_MAX_SEARCHES=7      web searches per brief
# RESEARCH_TTL_MS=43200000     brief cache, 12 h
# AUTONOMY_LIVE_TRIPS=1        every upcoming real booking becomes a FlightInstance in the graph, so live
#                              weather can raise predictions and the agents can act on real trips (off by
#                              default: with it on, a real alert can send real offers at any hour)
# AUTONOMY_TRIP_HORIZON_DAYS=10

# ---- Autonomy layer ------------------------------------------------------------
# Nothing required. Rollout gate lives in the graph (policy:autonomy_gate).
# Shadow mode = start, then POST /api/autonomy/kill {"global":true}
